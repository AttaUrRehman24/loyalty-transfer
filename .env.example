# Copy to .env to override values used by docker compose. Every value below is a safe
# local default. No secrets belong in this file or in the code.

# ---- Transfer engine (api + worker) -------------------------------------------------
# Postgres connection string (libpq format). Holds all durable state.
DATABASE_URL=postgresql://loyalty:loyalty@postgres:5432/loyalty
# Redis connection string. Used only for the short idempotency in-flight lock.
REDIS_URL=redis://redis:6379/0
# Database connections kept open per process.
DB_POOL_MIN_SIZE=2
# Maximum database connections per process. Keep below Postgres max_connections.
DB_POOL_MAX_SIZE=20
# Seconds to wait for a partner answer. A timeout makes the transfer UNKNOWN, never failed.
PARTNER_TIMEOUT_SECONDS=3
# Total tries for a partner credit on 5xx or connection errors (1 = no retry).
PARTNER_MAX_ATTEMPTS=3
# Backoff cap before the 2nd try; doubles each retry. Actual wait is random up to the cap.
PARTNER_BACKOFF_BASE_SECONDS=0.2
# Upper bound for any single retry wait.
PARTNER_BACKOFF_MAX_SECONDS=2
# Lifetime of the Redis in-flight lock. Must exceed the worst partner call time
# (attempts x timeout + retries x max backoff); startup fails otherwise.
IDEMPOTENCY_LOCK_TTL_SECONDS=30
# How long a dispatcher owns an outbox job before the relay may take it over.
# Same rule as the lock TTL.
OUTBOX_LEASE_SECONDS=30
# The reconciler only checks UNKNOWN transfers at least this old, giving slow partners
# time to finish the original request first.
RECONCILE_MIN_AGE_SECONDS=60
# Worker sleep between relay/reconcile cycles.
WORKER_POLL_INTERVAL_SECONDS=2
# Maximum outbox jobs or UNKNOWN transfers handled per cycle.
WORKER_BATCH_SIZE=50
# Log level for the JSON logs: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---- Seed script ---------------------------------------------------------------------
# Partner base URLs written into the programs table by scripts/seed.py.
CARD_PARTNER_URL=http://card-partner:9001
AIRLINE_PARTNER_URL=http://airline-partner:9002

# ---- Mock partners (card-partner and airline-partner containers) ------------------------
# Extra delay in ms before every credit answer.
MOCK_LATENCY_MS=0
# true = every credit call answers HTTP 503.
MOCK_FAIL_5XX=false
# none = normal; apply = apply credit then stall; drop = stall without applying.
MOCK_TIMEOUT_MODE=none
# How long to stall in apply/drop mode. Keep above PARTNER_TIMEOUT_SECONDS.
MOCK_TIMEOUT_DELAY_MS=5000
# true = apply the credit but answer with the partner's "duplicate" response.
MOCK_DUPLICATE_RESPONSES=false

# ---- Tests (make test) -----------------------------------------------------------------
# Database the test suite drops and recreates on every run. Never point at real data.
TEST_DATABASE_URL=postgresql://loyalty:loyalty@postgres:5432/loyalty_test
# Redis database the tests flush between cases.
TEST_REDIS_URL=redis://redis:6379/15
